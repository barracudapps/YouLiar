{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YouLiar",
  "version": "0.10.0",
  "identifier": "com.barracudapps.youliar",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "npm run web",
    "beforeDevCommand": "npm run web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "YouLiar",
        "width": 480,
        "height": 860,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; media-src 'self' blob: mediastream:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Détecteur de mensonges de soirée",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJFMTBENTREMkU2MEM1OTkKUldTWnhXQXVUZFVRdmlnbnNMUTIybHZydHVYQnNZQXRwTkRhMXVIS2dsOTRNSmJQcW8xa0cxWUYK",
      "endpoints": [
        "https://github.com/barracudapps/YouLiar/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
